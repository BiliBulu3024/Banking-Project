<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:backgroundTint="#6200EE"
        android:title="Chuyển tiền"
        android:titleTextColor="@android:color/white"
        app:menu="@menu/menu_dashboard"
        android:elevation="4dp" />
    <TextView
        android:text="Chuyển Khoản"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- Nhập số tài khoản -->
    <EditText
        android:id="@+id/etTargetAccount"
        android:hint="Số tài khoản người nhận"
        android:inputType="number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"/>

    <!-- Tên chủ tài khoản -->
    <TextView
        android:id="@+id/tvReceiverName"
        android:text="Tên người nhận sẽ hiển thị tại đây"
        android:textColor="#444"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="16sp"/>

    <!-- Amount -->
    <EditText
        android:id="@+id/etAmount"
        android:hint="Số tiền"
        android:inputType="numberDecimal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"/>

    <!-- Description -->
    <EditText
        android:id="@+id/etDescription"
        android:hint="Nội dung chuyển tiền"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"/>

    <!-- Submit -->
    <Button
        android:id="@+id/btnSubmit"
        android:text="Chuyển tiền"
        android:backgroundTint="#6200EE"
        android:textColor="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"/>
</LinearLayout>
